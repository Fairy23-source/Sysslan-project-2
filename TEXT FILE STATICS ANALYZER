#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main()
{
    string filename;
    cout << "Enter file name: ";
    cin >> filename;

    ifstream file(filename);

    // Check if file opens successfully
    if (!file)
    {
        cout << "Error: Cannot open file!" << endl;
        return 1;
    }

    string line;
    int lineCount = 0;
    int wordCount = 0;
    int charCount = 0;

    // Read file line by line
    while (getline(file, line))
    {
        lineCount++;

        // Count characters
        charCount += line.length();

        // Count words
        bool inWord = false;

        for (int i = 0; i < line.length(); i++)
        {
            if (line[i] != ' ' && line[i] != '\t')
            {
                if (!inWord)
                {
                    wordCount++;
                    inWord = true;
                }
            }
            else
            {
                inWord = false;
            }
        }
    }

    file.close();

    // Display results
    cout << "\n----- File Statistics -----" << endl;
    cout << "Total Lines      : " << lineCount << endl;
    cout << "Total Words      : " << wordCount << endl;
    cout << "Total Characters : " << charCount << endl;

    return 0;
}
